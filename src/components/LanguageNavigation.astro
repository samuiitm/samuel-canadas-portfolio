<script is:inline>
	(() => {
		const storageKey = 'portfolio-language-position';

		function getHeaderHeight() {
			return document.querySelector('[data-site-header]')?.getBoundingClientRect().height || 0;
		}

		function getCurrentPosition(targetPath) {
			const headerHeight = getHeaderHeight();
			const referenceY = window.scrollY + headerHeight + 1;
			const sections = Array.from(document.querySelectorAll('[data-language-section]'))
				.filter((section) => section.getBoundingClientRect().height > 0)
				.map((section) => {
					const rect = section.getBoundingClientRect();
					const top = window.scrollY + rect.top;
					return { section, top, height: rect.height, bottom: top + rect.height };
				});

			const current = sections.find(({ top, bottom }) => referenceY >= top && referenceY < bottom)
				|| sections.reduce((closest, candidate) => {
					const distance = referenceY < candidate.top
						? candidate.top - referenceY
						: referenceY > candidate.bottom ? referenceY - candidate.bottom : 0;
					if (!closest) return candidate;
					const closestDistance = referenceY < closest.top
						? closest.top - referenceY
						: referenceY > closest.bottom ? referenceY - closest.bottom : 0;
					return distance < closestDistance ? candidate : closest;
				}, null);

			return {
				section: current?.section.dataset.languageSection || null,
				progress: current
					? Math.min(1, Math.max(0, (referenceY - current.top) / Math.max(1, current.height)))
					: 0,
				scrollY: window.scrollY,
				targetPath,
				createdAt: Date.now(),
			};
		}

		document.addEventListener('click', (event) => {
			const link = event.target instanceof Element ? event.target.closest('[data-language-link]') : null;
			if (!link) return;
			if (link.getAttribute('aria-current') === 'page') {
				event.preventDefault();
				return;
			}
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

			const target = new URL(link.href);
			sessionStorage.setItem(storageKey, JSON.stringify(getCurrentPosition(target.pathname)));
			document.documentElement.dataset.languageTransition = 'true';
		}, { capture: true });

		function restorePosition() {
			const stored = sessionStorage.getItem(storageKey);
			if (!stored) {
				delete document.documentElement.dataset.languageTransition;
				return;
			}

			let position = null;
			try {
				position = JSON.parse(stored);
			} catch {
				sessionStorage.removeItem(storageKey);
			}

			if (!position || position.targetPath !== window.location.pathname || Date.now() - position.createdAt > 15_000) {
				sessionStorage.removeItem(storageKey);
				delete document.documentElement.dataset.languageTransition;
				return;
			}

			const applyPosition = () => {
				const targetSection = position.section
					? Array.from(document.querySelectorAll('[data-language-section]'))
						.find((section) => section.dataset.languageSection === position.section)
					: null;
				let targetY = position.scrollY;

				if (targetSection) {
					const rect = targetSection.getBoundingClientRect();
					const sectionTop = window.scrollY + rect.top;
					targetY = sectionTop + rect.height * position.progress - getHeaderHeight() - 1;
				}

				const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
				const clampedY = Math.min(maxScroll, Math.max(0, targetY));
				if (window.__portfolioLenis) {
					window.__portfolioLenis.scrollTo(clampedY, { immediate: true, force: true });
				} else {
					window.scrollTo({ top: clampedY, behavior: 'auto' });
				}
			};

			requestAnimationFrame(() => requestAnimationFrame(() => {
				applyPosition();
				window.setTimeout(() => {
					applyPosition();
					sessionStorage.removeItem(storageKey);
					window.setTimeout(() => delete document.documentElement.dataset.languageTransition, 40);
				}, 160);
			}));
		}

		restorePosition();
	})();
</script>
