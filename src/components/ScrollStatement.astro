<section class="statement depth-level-a" id="statement" aria-labelledby="statement-title" data-scroll-statement>
	<div class="statement__sticky">
		<div class="statement__inner container-normal">
			<p class="eyebrow">01 — Una forma de trabajar</p>
			<h2 class="statement__text" id="statement-title">
			<span class="sr-only">No separo lo creativo de lo técnico. Trabajo justo en medio.</span>
			<span class="statement__lines" aria-hidden="true">
				<span class="statement__line"><span class="statement__line-base">No separo lo</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">No separo lo</span></span></span>
				<span class="statement__line"><span class="statement__line-base">creativo de lo</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">creativo de lo</span></span></span>
				<span class="statement__line"><span class="statement__line-base">técnico. Trabajo</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">técnico. Trabajo</span></span></span>
				<span class="statement__line"><span class="statement__line-base">justo en medio.</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">justo en medio.</span></span></span>
			</span>
			</h2>
			<p class="statement__note">Texto provisional · El recorrido prueba ritmo y legibilidad.</p>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-scroll-statement]');
	const lineFills = Array.from(document.querySelectorAll<HTMLElement>('[data-statement-line-fill]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const ranges = [[0, 0.3], [0.22, 0.52], [0.46, 0.76], [0.7, 1]];
	let frameId: number | null = null;

	function renderStatement() {
		frameId = null;
		if (!section || lineFills.length === 0) return;
		if (reduceMotion.matches) {
			lineFills.forEach((line) => {
				line.style.setProperty('--line-progress', '100%');
				line.style.setProperty('--line-overscan', '0px');
				line.parentElement?.classList.add('is-complete');
			});
			return;
		}

		const rect = section.getBoundingClientRect();
		const distance = section.offsetHeight - window.innerHeight;
		const globalProgress = distance > 0 ? Math.min(1, Math.max(0, -rect.top / distance)) : 1;

		lineFills.forEach((line, index) => {
			const [start, end] = ranges[index];
			const lineProgress = Math.min(1, Math.max(0, (globalProgress - start) / (end - start)));
			line.style.setProperty('--line-progress', `${lineProgress * 100}%`);
			line.style.setProperty('--line-overscan', lineProgress > 0 && lineProgress < 1 ? '2px' : '0px');
			line.parentElement?.classList.toggle('is-complete', lineProgress >= 1);
		});
	}

	function updateStatement() {
		if (frameId !== null) return;
		frameId = requestAnimationFrame(renderStatement);
	}

	renderStatement();
	window.addEventListener('scroll', updateStatement, { passive: true });
	window.addEventListener('resize', updateStatement);
	reduceMotion.addEventListener('change', updateStatement);
</script>
