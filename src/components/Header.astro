---
import ThemeToggle from './ThemeToggle';
import { defaultLocale, ui } from '../lib/i18n';

const homeHref = Astro.url.pathname === '/' ? '' : '/';
const headerCopy = ui[defaultLocale].header;
---

<header class="site-header" data-site-header>
	<div class="site-header__inner container-wide">
		<a class="site-header__identity" href={`${homeHref}#top`}>Samuel Cañadas</a>
		<nav class="site-header__nav" aria-label={headerCopy.navigationLabel} data-header-navigation data-label-es={ui.es.header.navigationLabel} data-label-en={ui.en.header.navigationLabel}>
			<a href={`${homeHref}#work`} data-header-label data-label-es={ui.es.header.work} data-label-en={ui.en.header.work}>{headerCopy.work}</a>
			<a href={`${homeHref}#about`} data-header-label data-label-es={ui.es.header.about} data-label-en={ui.en.header.about}>{headerCopy.about}</a>
			<a href={`${homeHref}#archivo`} data-header-label data-label-es={ui.es.header.archive} data-label-en={ui.en.header.archive}>{headerCopy.archive}</a>
			<a href={`${homeHref}#contact`} data-header-label data-label-es={ui.es.header.contact} data-label-en={ui.en.header.contact}>{headerCopy.contact}</a>
		</nav>
		<div class="site-header__controls">
			<div class="language-toggle" role="group" aria-label={headerCopy.languageLabel} data-language-toggle data-label-es={ui.es.header.languageLabel} data-label-en={ui.en.header.languageLabel}>
				<button type="button" aria-pressed="true" data-locale-option="es">ES</button><span aria-hidden="true">/</span><button type="button" aria-pressed="false" data-locale-option="en">EN</button>
			</div>
			<ThemeToggle client:load />
		</div>
	</div>
</header>

<script>
	import { defaultLocale, locales, ui, type Locale } from '../lib/i18n';

	const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
	const headerNavigation = siteHeader?.querySelector<HTMLElement>('[data-header-navigation]');
	const headerLabels = siteHeader?.querySelectorAll<HTMLElement>('[data-header-label]') ?? [];
	const languageToggle = siteHeader?.querySelector<HTMLElement>('[data-language-toggle]');
	const localeOptions = siteHeader?.querySelectorAll<HTMLButtonElement>('[data-locale-option]') ?? [];
	let headerFrame: number | null = null;
	let measuredHeaderHeight = -1;
	let activeLocale: Locale = defaultLocale;

	function isLocale(value: string | null): value is Locale {
		return Boolean(value && locales.includes(value as Locale));
	}

	function applyLocale(locale: Locale) {
		activeLocale = locale;
		const copy = ui[locale].header;
		headerNavigation?.setAttribute('aria-label', copy.navigationLabel);
		languageToggle?.setAttribute('aria-label', copy.languageLabel);
		headerLabels.forEach((label) => {
			const translatedLabel = label.dataset[`label${locale === 'es' ? 'Es' : 'En'}`];
			if (translatedLabel) label.textContent = translatedLabel;
		});
		localeOptions.forEach((option) => option.setAttribute('aria-pressed', String(option.dataset.localeOption === locale)));
		localStorage.setItem('portfolio-locale', locale);
	}

	function handleLocaleChange(event: Event) {
		const option = event.currentTarget as HTMLButtonElement;
		const locale = option.dataset.localeOption ?? null;
		if (isLocale(locale) && locale !== activeLocale) applyLocale(locale);
	}

	function updateHeaderHeight() {
		if (!siteHeader) return;
		const nextHeight = siteHeader.getBoundingClientRect().height;
		if (Math.abs(nextHeight - measuredHeaderHeight) < 0.5) return;
		measuredHeaderHeight = nextHeight;
		document.documentElement.style.setProperty('--header-height', `${nextHeight.toFixed(2)}px`);
		window.dispatchEvent(new CustomEvent('portfolio:header-resize', { detail: { height: nextHeight } }));
	}

	function updateHeaderState() {
		headerFrame = null;
		siteHeader?.classList.toggle('is-scrolled', window.scrollY > 12);
	}

	function requestHeaderState() {
		if (headerFrame !== null) return;
		headerFrame = window.requestAnimationFrame(updateHeaderState);
	}

	const headerResizeObserver = siteHeader ? new ResizeObserver(updateHeaderHeight) : null;
	const savedLocale = localStorage.getItem('portfolio-locale');
	applyLocale(isLocale(savedLocale) ? savedLocale : defaultLocale);
	localeOptions.forEach((option) => option.addEventListener('click', handleLocaleChange));
	headerResizeObserver?.observe(siteHeader);
	updateHeaderHeight();
	updateHeaderState();
	window.addEventListener('scroll', requestHeaderState, { passive: true });
	document.addEventListener('astro:before-swap', () => {
		localeOptions.forEach((option) => option.removeEventListener('click', handleLocaleChange));
		headerResizeObserver?.disconnect();
		window.removeEventListener('scroll', requestHeaderState);
		if (headerFrame !== null) window.cancelAnimationFrame(headerFrame);
	}, { once: true });
</script>
