<section class="statement depth-level-a" id="statement" aria-labelledby="statement-title" data-scroll-statement>
	<div class="statement__sticky">
		<div class="statement__inner container-normal">
			<p class="eyebrow">01 — Una forma de trabajar</p>
			<h2 class="statement__text" id="statement-title">
			<span class="sr-only">Puedo estar con una web y al rato con un cartel, una publicación o detrás de la cámara.</span>
			<span class="statement__lines statement__lines--desktop" data-statement-lines aria-hidden="true">
				<span class="statement__line"><span class="statement__line-base">Puedo estar con una web</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">Puedo estar con una web</span></span></span>
				<span class="statement__line"><span class="statement__line-base">y al rato con un cartel, una</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">y al rato con un cartel, una</span></span></span>
				<span class="statement__line"><span class="statement__line-base">publicación o detrás de la cámara.</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">publicación o detrás de la cámara.</span></span></span>
			</span>
			<span class="statement__lines statement__lines--mobile" data-statement-lines aria-hidden="true">
				<span class="statement__line"><span class="statement__line-base">Puedo estar con una web</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">Puedo estar con una web</span></span></span>
				<span class="statement__line"><span class="statement__line-base">y al rato con un cartel,</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">y al rato con un cartel,</span></span></span>
				<span class="statement__line"><span class="statement__line-base">una publicación o detrás</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">una publicación o detrás</span></span></span>
				<span class="statement__line"><span class="statement__line-base">de la cámara.</span><span class="statement__line-reveal" data-statement-line-fill><span class="statement__line-fill">de la cámara.</span></span></span>
			</span>
			</h2>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-scroll-statement]');
	const lineGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-statement-lines]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let frameId: number | null = null;

	function renderStatement() {
		frameId = null;
		const activeGroup = lineGroups.find((group) => getComputedStyle(group).display !== 'none');
		const lineFills = Array.from(activeGroup?.querySelectorAll<HTMLElement>('[data-statement-line-fill]') ?? []);
		if (!section || lineFills.length === 0) return;
		const overlap = lineFills.length === 3 ? 0.06 : 0.045;
		const segment = (1 + overlap * (lineFills.length - 1)) / lineFills.length;
		if (reduceMotion.matches) {
			lineFills.forEach((line) => {
				line.style.setProperty('--line-progress', '100%');
				line.style.setProperty('--line-overscan', '0px');
				line.parentElement?.classList.add('is-complete');
			});
			return;
		}

		const rect = section.getBoundingClientRect();
		const headerHeight = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0;
		const availableHeight = Math.max(1, window.innerHeight - headerHeight);
		const distance = section.offsetHeight - availableHeight;
		const globalProgress = distance > 0 ? Math.min(1, Math.max(0, (headerHeight - rect.top) / distance)) : 1;

		lineFills.forEach((line, index) => {
			const start = Math.max(0, index * (segment - overlap));
			const end = Math.min(1, start + segment);
			const lineProgress = Math.min(1, Math.max(0, (globalProgress - start) / (end - start)));
			line.style.setProperty('--line-progress', `${lineProgress * 100}%`);
			line.style.setProperty('--line-overscan', lineProgress > 0 && lineProgress < 1 ? '2px' : '0px');
			line.parentElement?.classList.toggle('is-complete', lineProgress >= 1);
		});
	}

	function updateStatement() {
		if (frameId !== null) return;
		frameId = requestAnimationFrame(renderStatement);
	}

	renderStatement();
	window.addEventListener('scroll', updateStatement, { passive: true });
	window.addEventListener('resize', updateStatement);
	window.addEventListener('portfolio:header-resize', updateStatement);
	reduceMotion.addEventListener('change', updateStatement);
</script>
