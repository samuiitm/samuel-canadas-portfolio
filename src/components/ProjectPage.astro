---
import type { PortfolioProject } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomePath, getProjectPath, type Locale } from '../lib/i18n';
import Header from './Header.astro';

interface Props {
	project: PortfolioProject;
	locale: Locale;
}

const { project, locale } = Astro.props;
const copy = locale === 'en' ? {
	home: 'Home', work: 'Work', caseStudy: 'Case study', back: 'Back to projects', logo: 'Logo of', breadcrumb: 'Breadcrumb',
} : {
	home: 'Inicio', work: 'Proyectos', caseStudy: 'Caso de estudio', back: 'Volver a proyectos', logo: 'Logo de', breadcrumb: 'Ruta de navegación',
};
const canonicalPath = getProjectPath(project.slug, locale);
const homePath = getHomePath(locale);
const workPath = `${homePath}#work`;
const spanishPath = getProjectPath(project.slug, 'es');
const englishPath = getProjectPath(project.slug, 'en');
const canonicalUrl = `https://samuelcanadas.com${canonicalPath}`;
const pageId = `${canonicalUrl}#webpage`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const workId = `https://samuelcanadas.com/#project-${project.slug}`;
const primaryProjectUrl = `https://samuelcanadas.com/proyectos/${project.slug}/`;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': pageId,
			url: canonicalUrl,
			name: project.pageTitle,
			description: project.metaDescription,
			inLanguage: locale,
			isPartOf: { '@id': 'https://samuelcanadas.com/#website' },
			breadcrumb: { '@id': breadcrumbId },
			mainEntity: { '@id': workId },
		},
		{
			'@type': 'BreadcrumbList',
			'@id': breadcrumbId,
			inLanguage: locale,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: copy.home, item: new URL(homePath, 'https://samuelcanadas.com').href },
				{ '@type': 'ListItem', position: 2, name: copy.work, item: new URL(workPath, 'https://samuelcanadas.com').href },
				{ '@type': 'ListItem', position: 3, name: project.name, item: canonicalUrl },
			],
		},
		{
			'@type': 'CreativeWork',
			'@id': workId,
			url: primaryProjectUrl,
			mainEntityOfPage: { '@id': pageId },
			name: project.name,
			description: project.metaDescription,
			inLanguage: locale,
			image: new URL(project.ogImage, 'https://samuelcanadas.com').href,
			author: { '@id': 'https://samuelcanadas.com/#person' },
			sameAs: project.officialUrl,
		},
	],
};
---

<BaseLayout
	title={project.pageTitle}
	description={project.metaDescription}
	lang={locale}
	canonicalPath={canonicalPath}
	alternates={{ es: spanishPath, en: englishPath, xDefault: spanishPath }}
	image={project.ogImage}
	imageWidth={project.ogImageWidth}
	imageHeight={project.ogImageHeight}
	imageAlt={project.ogImageAlt}
	type="article"
	structuredData={structuredData}
>
	<Header locale={locale} />
	<main class:list={['case-page', `case-page--${project.id}`]} data-language-section="project">
		<article>
			<header class="case-page__hero container-wide">
				<nav class="case-page__breadcrumb" aria-label={copy.breadcrumb}>
					<ol>
						<li><a href={homePath}>{copy.home}</a></li>
						<li><a href={workPath}>{copy.work}</a></li>
						<li aria-current="page">{project.name}</li>
					</ol>
				</nav>
				<div class="case-page__heading">
					<div>
						<p class="eyebrow">{project.index} — {copy.caseStudy}</p>
						<h1>{project.name}</h1>
					</div>
					<div class="case-page__summary">
						<p>{project.descriptor}</p>
						<span>{project.areas} · {project.year}</span>
					</div>
				</div>
				<figure class="case-page__cover">
					<img src={project.cover} alt={project.coverAlt} width={project.coverWidth} height={project.coverHeight} loading="eager" decoding="async" fetchpriority="high" />
					<img class="case-page__logo" src={project.logo} alt={`${copy.logo} ${project.name}`} width={project.logoWidth} height={project.logoHeight} decoding="async" />
				</figure>
			</header>

			<div class="case-page__chapters container-normal">
				{project.chapters.map((chapter, index) => (
					<section class="case-page__chapter" aria-labelledby={`${project.id}-chapter-${index + 1}`}>
						<div class="case-page__chapter-copy">
							<span>0{index + 1}</span>
							<h2 id={`${project.id}-chapter-${index + 1}`}>{chapter.title}</h2>
							<p>{chapter.copy}</p>
						</div>
						<figure class="case-page__chapter-media">
							<img src={chapter.image} alt={chapter.alt} width={chapter.imageWidth} height={chapter.imageHeight} loading="lazy" decoding="async" />
						</figure>
					</section>
				))}
			</div>

			<footer class="case-page__footer container-wide">
				<a href={workPath}>← {copy.back}</a>
				<a href={project.officialUrl} target="_blank" rel="noopener noreferrer">{project.officialLabel} <span aria-hidden="true">↗</span></a>
			</footer>
		</article>
	</main>
</BaseLayout>
