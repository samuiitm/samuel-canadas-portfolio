---
import { homeContent } from '../data/content';
import { defaultLocale, type Locale } from '../lib/i18n';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const copy = homeContent[locale].international;
---

<aside class="international-note container-normal" aria-labelledby="international-title" data-language-section="international">
	<p class="eyebrow">{copy.eyebrow}</p>
	<div class="international-note__content">
		<h2 id="international-title">{copy.title}</h2>
		<p>{copy.description}</p>
	</div>
	<figure class="international-note__asset">
		<img
			src="/images/projects/decorama-art-home.webp"
			alt={copy.imageAlt}
			width="1902"
			height="1079"
			loading="lazy"
			decoding="async"
		/>
	</figure>
	<span aria-hidden="true">MT / 2026</span>
	<a
		class="international-note__link"
		href="https://www.decoramaart.com/"
		target="_blank"
		rel="noopener noreferrer"
		aria-label={copy.linkLabel}
	>
		<span class="sr-only">{copy.linkLabel}</span>
	</a>
</aside>
