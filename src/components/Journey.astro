---
const stages = [
	{ title: 'Informática', meta: 'Base técnica', copy: 'Empecé por informática porque siempre me había gustado entender cómo funcionan las cosas y trastear con ordenadores.', pulse: 'technical' },
	{ title: 'Portugal', meta: 'Erasmus+ · Pax Jovem', copy: 'Mi primera experiencia fuera. Me sirvió para espabilarme, trabajar con gente nueva y empezar a salir bastante de mi zona de confort.', pulse: 'creative' },
	{ title: 'Desarrollo web', meta: 'Formación superior', copy: 'Después llegó el desarrollo web. Ahí empecé a convertir ideas en proyectos que ya se podían enseñar y utilizar de verdad.', pulse: 'technical' },
	{ title: 'Malta', meta: 'Erasmus+ · Decorama', copy: 'Tres meses de Erasmus trabajando en inglés y bastante por mi cuenta. Una experiencia que me obligó a desenvolverme de otra manera.', pulse: 'both' },
	{ title: 'Nova Unió', meta: 'Producto real', copy: 'Empezó como un proyecto de clase y terminó convirtiéndose en una web y una herramienta real para un club que conozco desde dentro.', pulse: 'technical' },
	{ title: 'Nova Fight Legacy', meta: 'Identidad y comunicación', copy: 'Aquí fue donde más empecé a tirar hacia la parte creativa: diseño, vídeo, redes y toda la imagen de un evento desde cero.', pulse: 'creative' },
	{ title: 'Comfortek', meta: 'Entorno técnico', copy: 'Una etapa bastante distinta, trabajando en domótica y en un entorno mucho más técnico y nuevo para mí. También me sirvió para tener más claro hacia dónde quería tirar.', pulse: 'technical' },
	{ title: 'Ahora', meta: 'Dos partes, un perfil', copy: 'Ahora sé bastante mejor dónde encajo: en proyectos donde puedo mezclar desarrollo web, diseño, contenido y marketing.', pulse: 'both' },
] as const;
---

<section class="journey depth-level-a" id="about" aria-labelledby="journey-title" data-journey>
	<div class="journey__inner container-normal">
		<header class="journey__heading">
			<p class="eyebrow">03 — Recorrido</p>
			<h2 id="journey-title">He ido descubriendo dónde encajo mejor.</h2>
		</header>
		<ol class="journey__list">
			{stages.map((stage, index) => (
				<li class="journey__entry" data-journey-stage data-pulse={stage.pulse}>
					<div class="journey__index" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
					<div class="journey__stage"><p class="journey__meta">{stage.meta}</p><h3>{stage.title}</h3></div>
					<p class="journey__copy">{stage.copy}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<script>
	const journey = document.querySelector<HTMLElement>('[data-journey]');
	const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-journey-stage]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (journey && stages.length && !reduceMotion.matches) {
		journey.classList.add('has-motion');
		const setActiveStage = () => {
			const focusY = window.innerHeight * 0.48;
			let activeIndex = 0;
			let closestDistance = Number.POSITIVE_INFINITY;
			stages.forEach((stage, index) => {
				const rect = stage.getBoundingClientRect();
				const distance = Math.abs(rect.top + rect.height / 2 - focusY);
				if (distance < closestDistance) { closestDistance = distance; activeIndex = index; }
			});
			stages.forEach((stage, index) => {
				stage.classList.toggle('is-active', index === activeIndex);
				stage.classList.toggle('is-past', index < activeIndex);
			});
		};
		const observer = new IntersectionObserver(setActiveStage, { rootMargin: '-18% 0px -18% 0px', threshold: [0, 0.35, 0.7] });
		stages.forEach((stage) => observer.observe(stage));
		setActiveStage();
		document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
	}
</script>
