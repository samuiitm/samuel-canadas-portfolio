---
import { homeContent } from '../data/content';
import { defaultLocale, type Locale } from '../lib/i18n';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const copy = homeContent[locale].journey;
const stages = copy.stages;
---

<section class="journey depth-level-a" id="about" aria-labelledby="journey-title" data-journey data-language-section="about">
	<div class="journey__inner container-normal">
		<header class="journey__heading">
			<p class="eyebrow">{copy.eyebrow}</p>
			<h2 id="journey-title">{copy.title}</h2>
		</header>
		<ol class="journey__list">
			{stages.map((stage, index) => (
				<li class="journey__entry" data-journey-stage data-pulse={stage.pulse}>
					<div class="journey__index" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
					<div class="journey__stage"><p class="journey__meta">{stage.meta}</p><h3>{stage.title}</h3></div>
					<p class="journey__copy">{stage.copy}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<script>
	const journey = document.querySelector<HTMLElement>('[data-journey]');
	const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-journey-stage]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (journey && stages.length && !reduceMotion.matches) {
		journey.classList.add('has-motion');
		const setActiveStage = () => {
			const focusY = window.innerHeight * 0.48;
			let activeIndex = 0;
			let closestDistance = Number.POSITIVE_INFINITY;
			stages.forEach((stage, index) => {
				const rect = stage.getBoundingClientRect();
				const distance = Math.abs(rect.top + rect.height / 2 - focusY);
				if (distance < closestDistance) { closestDistance = distance; activeIndex = index; }
			});
			stages.forEach((stage, index) => {
				stage.classList.toggle('is-active', index === activeIndex);
				stage.classList.toggle('is-past', index < activeIndex);
			});
		};
		const observer = new IntersectionObserver(setActiveStage, { rootMargin: '-18% 0px -18% 0px', threshold: [0, 0.35, 0.7] });
		stages.forEach((stage) => observer.observe(stage));
		setActiveStage();
		document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
	}
</script>
