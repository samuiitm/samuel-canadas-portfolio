---
import ThemeToggle from './ThemeToggle';
import { defaultLocale, getHomePath, getLocalizedPath, localeLabels, ui, type Locale } from '../lib/i18n';

interface Props { locale?: Locale; }

const { locale = defaultLocale } = Astro.props;
const homeHref = getHomePath(locale);
const headerCopy = ui[locale].header;
const spanishPath = getLocalizedPath(Astro.url.pathname, 'es');
const englishPath = getLocalizedPath(Astro.url.pathname, 'en');
---

<header class="site-header" data-site-header>
	<div class="site-header__inner container-wide">
		<a class="site-header__identity" href={`${homeHref}#top`}>Samuel Cañadas</a>
		<nav class="site-header__nav" aria-label={headerCopy.navigationLabel}>
			<a href={`${homeHref}#work`}>{headerCopy.work}</a>
			<a href={`${homeHref}#about`}>{headerCopy.about}</a>
			<a href={`${homeHref}#archivo`}>{headerCopy.archive}</a>
			<a href={`${homeHref}#contact`}>{headerCopy.contact}</a>
		</nav>
		<div class="site-header__controls">
			<div class="language-toggle" role="group" aria-label={headerCopy.languageLabel}>
				<a href={spanishPath} lang="es" hreflang="es" aria-label={localeLabels.es} aria-current={locale === 'es' ? 'page' : undefined} data-language-link>ES</a>
				<span aria-hidden="true">/</span>
				<a href={englishPath} lang="en" hreflang="en" aria-label={localeLabels.en} aria-current={locale === 'en' ? 'page' : undefined} data-language-link>EN</a>
			</div>
			<ThemeToggle locale={locale} client:load />
		</div>
	</div>
</header>

<script>
	let headerFrame: number | null = null;
	let measuredHeaderHeight = -1;

	function updateHeaderHeight() {
		const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
		if (!siteHeader) return;
		const nextHeight = siteHeader.getBoundingClientRect().height;
		if (Math.abs(nextHeight - measuredHeaderHeight) < 0.5) return;
		measuredHeaderHeight = nextHeight;
		document.documentElement.style.setProperty('--header-height', `${nextHeight.toFixed(2)}px`);
		window.dispatchEvent(new CustomEvent('portfolio:header-resize', { detail: { height: nextHeight } }));
	}

	function updateHeaderState() {
		headerFrame = null;
		document.querySelector<HTMLElement>('[data-site-header]')?.classList.toggle('is-scrolled', window.scrollY > 12);
	}

	function requestHeaderState() {
		if (headerFrame !== null) return;
		headerFrame = window.requestAnimationFrame(updateHeaderState);
	}

	const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
	const headerResizeObserver = siteHeader ? new ResizeObserver(updateHeaderHeight) : null;
	headerResizeObserver?.observe(siteHeader!);
	window.addEventListener('scroll', requestHeaderState, { passive: true });
	updateHeaderHeight();
	updateHeaderState();
	document.addEventListener('astro:before-swap', () => {
		headerResizeObserver?.disconnect();
		window.removeEventListener('scroll', requestHeaderState);
		if (headerFrame !== null) window.cancelAnimationFrame(headerFrame);
	}, { once: true });
</script>
