---
import Contact from '../components/Contact.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import InternationalNote from '../components/InternationalNote.astro';
import Journey from '../components/Journey.astro';
import PersonalPlaceholder from '../components/PersonalPlaceholder.astro';
import ProjectShowcase from '../components/ProjectShowcase';
import ScrollStatement from '../components/ScrollStatement.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Samuel Cañadas — Portfolio"
	description="Portfolio de Samuel Cañadas, Marketing Digital & Creativo y Desarrollo Web."
>
	<Header />
	<main>
		<Hero />
		<ScrollStatement />
		<ProjectShowcase client:load />
