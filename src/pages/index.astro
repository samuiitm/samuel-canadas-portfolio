---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import InternationalNote from '../components/InternationalNote.astro';
import Journey from '../components/Journey.astro';
import Personal from '../components/Personal.astro';
import PersonalInterlude from '../components/PersonalInterlude.astro';
import ProjectShowcase from '../components/ProjectShowcase';
import ScrollStatement from '../components/ScrollStatement.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Samuel Cañadas — Portfolio"
	description="Portfolio de Samuel Cañadas, Desarrollo Web y Marketing Digital & Creativo."
>
	<Header />
	<main>
		<Hero />
		<ScrollStatement />
		<ProjectShowcase client:load />
