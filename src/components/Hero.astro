---
import { homeContent } from '../data/content';
import { defaultLocale, type Locale } from '../lib/i18n';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const copy = homeContent[locale].hero;
---

<section class="hero depth-level-b" id="top" aria-labelledby="hero-title" data-hero data-language-section="top">
	<div class="hero__atmosphere" aria-hidden="true"></div>
	<div class="hero__inner container-wide">
		<div class="hero__edition" aria-hidden="true">{copy.edition}</div>
		<figure class="hero-photo" data-hero-photo>
			<div class="hero-photo__media">
				<picture>
					<source
						type="image/webp"
						srcset="/images/hero/samuel-nfl-staff-640.webp 640w, /images/hero/samuel-nfl-staff-960.webp 960w, /images/hero/samuel-nfl-staff-1152.webp 1152w"
						sizes="(max-width: 48rem) calc(100vw - 3rem), (max-width: 80rem) 43vw, 35rem"
					/>
					<img
						src="/images/hero/samuel-nfl-staff.jpg"
						alt={copy.imageAlt}
						width="1152"
						height="1536"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</picture>
			</div>
			<figcaption class="hero__caption">{copy.caption}</figcaption>
			<div class="hero__descriptor" aria-label={copy.descriptorLabel}>
				<p>{copy.descriptorOne[0]}<br />{copy.descriptorOne[1]}</p><span aria-hidden="true">+</span><p>{copy.descriptorTwo[0]}<br />{copy.descriptorTwo[1]}</p>
			</div>
		</figure>
		<div class="hero__main-content">
			<h1 class="hero__title" id="hero-title"><span>Samuel</span><span>Cañadas.</span></h1>
			<nav class="hero__actions" aria-label={copy.actionsLabel}>
				<a class="hero__action hero__action--primary" href="#work">{copy.workCta} <span aria-hidden="true">↓</span></a>
				<a class="hero__action hero__action--secondary" href="/Samuel-Canadas-CV.pdf" download="Samuel-Canadas-CV.pdf" aria-label={copy.cvLabel}>{copy.cvCta} <span aria-hidden="true">↓</span></a>
			</nav>
		</div>
	</div>
</section>

<script>
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const photo = document.querySelector<HTMLElement>('[data-hero-photo]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let heroFrame: number | null = null;
	function renderHeroMotion() {
		heroFrame = null;
		if (!hero || !photo) return;
		if (reducedMotion.matches) {
			photo.style.removeProperty('--photo-shift');
			photo.style.removeProperty('--photo-scale');
			return;
		}
		const progress = Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / hero.offsetHeight));
		photo.style.setProperty('--photo-shift', `${progress * 32}px`);
		photo.style.setProperty('--photo-scale', `${1 + progress * 0.02}`);
	}
	function requestHeroMotion() {
		if (heroFrame !== null) return;
		heroFrame = requestAnimationFrame(renderHeroMotion);
	}
	requestAnimationFrame(() => hero?.classList.add('is-ready'));
	renderHeroMotion();
	window.addEventListener('scroll', requestHeroMotion, { passive: true });
	window.addEventListener('resize', requestHeroMotion);
	reducedMotion.addEventListener('change', requestHeroMotion);
</script>
